# --- API ---
API_PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
# Leave empty to use the in-memory store (zero setup). Set to use MongoDB:
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB=crm_copilot
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
LOGIN_RATE_LIMIT_MAX=10
MCP_SERVICE_TOKEN=dev-mcp-token        # read + write only
ADMIN_SERVICE_TOKEN=dev-admin-token    # read + write + delete
ADMIN_PASSWORD=admin123
VIEWER_PASSWORD=viewer123

# --- MCP server / agent ---
API_URL=http://localhost:3000
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
